{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "sh docs/scripts/install_site.sh",
  "buildCommand": "sh docs/scripts/build_site.sh",
  "outputDirectory": "site",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "truthound-docs.vercel.app"
        }
      ],
      "destination": "https://www.truthound-docs.tech/:path*",
      "permanent": true
    },
    {
      "source": "/ko/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ko/:path*/",
      "destination": "/:path*/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
